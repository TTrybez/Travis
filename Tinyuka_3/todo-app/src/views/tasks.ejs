<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Your Tasks</title>
</head>
<body>
    <div class="container">
        <h1>Your Tasks</h1>
        <form action="/tasks" method="POST">
            <input type="text" name="title" placeholder="New Task" required>
            <button type="submit">Add Task</button>
        </form>
        <h2>Pending Tasks</h2>
        <ul>
            <% tasks.filter(task => task.status === 'pending').forEach(task => { %>
                <li>
                    <%= task.title %>
                    <form action="/tasks/<%= task._id %>/complete" method="POST" style="display:inline;">
                        <button type="submit">Complete</button>
                    </form>
                    <form action="/tasks/<%= task._id %>/delete" method="POST" style="display:inline;">
                        <button type="submit">Delete</button>
                    </form>
                </li>
            <% }); %>
        </ul>
        <h2>Completed Tasks</h2>
        <ul>
            <% tasks.filter(task => task.status === 'completed').forEach(task => { %>
                <li>
                    <%= task.title %>
                    <form action="/tasks/<%= task._id %>/delete" method="POST" style="display:inline;">
                        <button type="submit">Delete</button>
                    </form>
                </li>
            <% }); %>
        </ul>
    </div>
</body>
</html>